---
import BaseLayout from '../layouts/BaseLayout.astro';

const guarantees = [
  { title: 'Your data never leaves your device', body: 'GutCheck stores everything in a local Isar database on your phone. There is no GutCheck server. There is no cloud sync. There is no account to create.' },
  { title: 'No analytics, no telemetry',          body: 'The app does not phone home. It does not count screen views, does not log crashes remotely, does not know you exist.' },
  { title: 'No third-party SDKs',                 body: 'No Google Analytics. No Firebase. No Mixpanel. The only network traffic is what you explicitly trigger (like visiting a link).' },
  { title: 'You can export and delete anytime',   body: 'Export your full history to JSON with one tap. Clear sample data or all data from Settings. You are always in control.' },
  { title: 'Open source, auditable',              body: 'Every line of code is public under the AGPLv3. You (or anyone) can verify these claims by reading the source.' },
];

const answers = [
  { q: 'Do you have my data?',                          a: 'No. We never receive it. It is stored only on your device.' },
  { q: 'What happens if I lose my phone?',              a: "You'll lose your log (there's no cloud backup by design). We recommend periodically exporting to JSON and keeping a copy somewhere you trust." },
  { q: 'Is there a backup/sync feature?',               a: 'Not yet. If one ships, it will be opt-in, end-to-end encrypted, and work with a provider you choose (e.g. your own storage).' },
  { q: 'What permissions does the app request?',        a: 'Only what is strictly needed to function. No location, no contacts, no microphone.' },
  { q: 'Who runs this?',                                a: 'GutCheck is an open-source project. See the GitHub repository for maintainers and contributors.' },
];
---
<BaseLayout title="Privacy — GutCheck" description="How GutCheck handles your data. Spoiler: it doesn't, because the data never leaves your device.">
  <section class="container-narrow pt-20 pb-10">
    <span class="eyebrow">Privacy</span>
    <h1 class="mt-4 text-4xl sm:text-5xl font-bold tracking-tight max-w-3xl">Privacy as a default, not a feature.</h1>
    <p class="mt-5 text-lg text-slate-600 dark:text-slate-300 max-w-2xl">
      Health data is sensitive. GutCheck is built so we literally cannot see yours — it never leaves your device in the first place.
    </p>
  </section>

  <section class="container-narrow py-10">
    <div class="grid gap-4 md:grid-cols-2">
      {guarantees.map(g => (
        <div class="card p-6">
          <div class="flex items-start gap-3">
            <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600 ring-1 ring-brand-200 dark:bg-brand-500/10 dark:text-brand-300 dark:ring-brand-500/30">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div>
              <h3 class="font-semibold">{g.title}</h3>
              <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{g.body}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="container-narrow py-16">
    <h2 class="text-3xl font-bold tracking-tight">Questions you might have</h2>
    <div class="mt-8 divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white dark:divide-slate-800 dark:border-slate-800 dark:bg-slate-900/60">
      {answers.map(f => (
        <details class="group p-6 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer items-center justify-between gap-4 font-semibold">
            {f.q}
            <svg class="h-5 w-5 shrink-0 transition group-open:rotate-180 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-400">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="container-narrow py-16">
    <h2 class="text-3xl font-bold tracking-tight">Legal information (GDPR)</h2>
    <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">Last updated: 9 May 2026</p>

    <div class="mt-8 space-y-8 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
      <div>
        <h3 class="font-semibold text-slate-900 dark:text-slate-100">Data controller</h3>
        <p class="mt-2">
          Konstantin Unruh — <a class="link-muted underline" href="mailto:freaxmate@protonmail.com">freaxmate@protonmail.com</a>.
          GutCheck is a non-commercial open-source project. There is no company behind it.
        </p>
      </div>

      <div>
        <h3 class="font-semibold text-slate-900 dark:text-slate-100">The GutCheck app</h3>
        <p class="mt-2">
          The GutCheck mobile app does not transmit any data to us or any third party.
          All meal logs, wellness entries, and settings are stored exclusively in a local
          Isar database on your device. There is no account system, no cloud sync, and
          no analytics or crash-reporting SDK. We have no technical means to access your data.
        </p>
      </div>

      <div>
        <h3 class="font-semibold text-slate-900 dark:text-slate-100">This website</h3>
        <p class="mt-2">
          This site is hosted on GitHub Pages (GitHub, Inc., 88 Colin P Kelly Jr St, San Francisco,
          CA 94107, USA). GitHub processes your IP address and HTTP request metadata in their
          server logs to deliver the page and prevent abuse. This processing is based on our
          legitimate interest (Art. 6(1)(f) GDPR) in operating the site. International transfers
          are covered by the EU–US Data Privacy Framework. See
          <a class="link-muted underline" href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" rel="noopener">GitHub's privacy statement</a>.
        </p>
        <p class="mt-2">
          The site itself sets <strong>no cookies</strong> and uses <strong>no analytics, tracking pixels, or third-party SDKs</strong>.
          Web fonts (Inter) are bundled into the site — your browser does not request fonts from Google or any other third party.
          The site stores one item in your browser's <code>localStorage</code> (<code>theme</code>) to remember your light/dark
          preference. This is necessary for the requested feature and not used for tracking (Art. 6(1)(f) GDPR; ePrivacy Directive Art. 5(3) — strictly necessary).
          You can clear it anytime via your browser settings.
        </p>
      </div>

      <div>
        <h3 class="font-semibold text-slate-900 dark:text-slate-100">Your rights</h3>
        <p class="mt-2">
          Under the GDPR you have the right to access, rectify, erase, restrict, or port your
          personal data, and to object to processing (Art. 15–22 GDPR). Since the app stores
          data only on your device and the website does not collect personal data beyond the
          server-log processing described above, most of these rights are exercised directly
          by you (export or delete data in the app, clear browser storage). For requests
          related to GitHub's server-log processing, contact GitHub directly. For anything
          else, email <a class="link-muted underline" href="mailto:freaxmate@protonmail.com">freaxmate@protonmail.com</a>.
        </p>
        <p class="mt-2">
          You also have the right to lodge a complaint with a supervisory authority
          (Art. 77 GDPR), e.g. your local Datenschutzbehörde.
        </p>
      </div>

      <div>
        <h3 class="font-semibold text-slate-900 dark:text-slate-100">Changes</h3>
        <p class="mt-2">
          This statement may be updated when the project changes. The version history is
          public in the project's git repository.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
const BASE = import.meta.env.BASE_URL;

const platforms = [
  { name: 'iOS',     note: 'App Store — coming soon',         icon: '<path d="M16 1a3 3 0 0 0-3 3M8 5c-3 0-5 2-5 6s2 12 5 12c2 0 3-1 4-1s2 1 4 1c3 0 5-8 5-11s-2-6-5-6c-2 0-3 1-4 1s-2-1-4-2z"/>' },
  { name: 'Android', note: 'Play Store — coming soon',        icon: '<rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 10v4M16 10v4M9 3l1 3M15 3l-1 3"/>' },
  { name: 'Web (PWA)', note: 'Installable progressive web app', icon: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z"/>' },
  { name: 'Linux',   note: 'Build from source (below)',         icon: '<path d="M12 2a5 5 0 0 0-5 5c0 3 2 5 2 8s-3 4-3 6 2 1 6 1 6 1 6-1-3-4-3-6 2-5 2-8a5 5 0 0 0-5-5z"/>' },
  { name: 'macOS',   note: 'Build from source (below)',         icon: '<rect x="2" y="4" width="20" height="14" rx="2"/><line x1="8" y1="22" x2="16" y2="22"/><line x1="12" y1="18" x2="12" y2="22"/>' },
];
---
<BaseLayout title="Download — GutCheck" description="Install GutCheck on iOS, Android, Web, Linux, or macOS. Store releases coming soon — build from source today.">
  <section class="container-narrow pt-20 pb-10">
    <span class="eyebrow">Download</span>
    <h1 class="mt-4 text-4xl sm:text-5xl font-bold tracking-tight max-w-3xl">Install GutCheck.</h1>
    <p class="mt-5 text-lg text-slate-600 dark:text-slate-300 max-w-2xl">
      Store releases are on the way. In the meantime, GutCheck runs anywhere Flutter runs — which means you can build it yourself in minutes.
    </p>
  </section>

  <section class="container-narrow py-10">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {platforms.map(p => (
        <div class="card p-6">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-50 text-brand-600 ring-1 ring-brand-200 dark:bg-brand-500/10 dark:text-brand-300 dark:ring-brand-500/30">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
          </div>
          <h3 class="mt-4 font-semibold">{p.name}</h3>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{p.note}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-narrow py-16">
    <h2 class="text-3xl font-bold tracking-tight">Build from source</h2>
    <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-300">Requires <a class="underline underline-offset-2 decoration-brand-500" href="https://docs.flutter.dev/get-started/install">Flutter 3.41+</a>. Clone the repo, fetch dependencies, and run.</p>

    <div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-slate-950 text-slate-100 dark:border-slate-800">
      <div class="flex items-center gap-2 border-b border-slate-800/80 px-4 py-2 text-xs text-slate-400">
        <span class="h-2.5 w-2.5 rounded-full bg-red-400/80"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-yellow-400/80"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-green-400/80"></span>
        <span class="ml-2">terminal</span>
      </div>
      <pre class="px-5 py-5 text-sm leading-relaxed overflow-x-auto"><code><span class="text-slate-500"># 1. Clone</span>
git clone https://github.com/FreaxMATE/GutCheck.git
cd GutCheck

<span class="text-slate-500"># 2. Install dependencies</span>
flutter pub get

<span class="text-slate-500"># 3. Generate Isar types + localizations</span>
flutter gen-l10n
flutter pub run build_runner build --delete-conflicting-outputs

<span class="text-slate-500"># 4. Run (desktop, mobile, or web)</span>
flutter run</code></pre>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-3">
      <a href="https://github.com/FreaxMATE/GutCheck/releases" class="card p-5 transition hover:-translate-y-0.5 hover:shadow-glow">
        <h3 class="font-semibold">Releases</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Pre-built binaries (when available).</p>
      </a>
      <a href="https://github.com/FreaxMATE/GutCheck" class="card p-5 transition hover:-translate-y-0.5 hover:shadow-glow">
        <h3 class="font-semibold">Source</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">All the code, on GitHub.</p>
      </a>
      <a href="https://github.com/FreaxMATE/GutCheck/issues" class="card p-5 transition hover:-translate-y-0.5 hover:shadow-glow">
        <h3 class="font-semibold">Issues</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Report bugs or request features.</p>
      </a>
    </div>
  </section>
</BaseLayout>

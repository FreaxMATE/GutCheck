---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
const BASE = import.meta.env.BASE_URL;

const features = [
  { icon: 'shield',   title: 'Private by design',    text: 'Your data stays on your device. No cloud, no tracking, no account required.' },
  { icon: 'chart',    title: 'Smart correlations',   text: 'Pearson correlations surface which foods line up with how you feel, automatically.' },
  { icon: 'activity', title: 'Food fingerprints',    text: 'Per-ingredient symptom radars show exactly how each food tends to affect you.' },
  { icon: 'utensils', title: 'Fast meal logging',    text: 'A curated, bilingual pantry (EN/DE) of 115+ foods. Tap to log — no typing needed.' },
  { icon: 'heart',    title: 'Wellness check-ins',   text: 'A minute-long daily check-in captures discomfort, heartburn, stress, and more.' },
  { icon: 'wifi',     title: 'Works offline',        text: 'Built local-first with Isar. The whole app runs without a connection.' },
];

// The six "tour" screenshots. `name` resolves to the shared basename —
// PhoneFrame picks the right theme-inverse variant automatically.
const shots = [
  { name: '1_startpage.png',          title: 'Daily dashboard',   desc: 'See your latest wellness check, last meal, and 7-day average in one glance.' },
  { name: '4_wellness_check.png',     title: 'Wellness check-in', desc: 'A quick guided form with sliders for discomfort, heartburn, and stress — plus a compact bloating selector.' },
  { name: '3_meal_log.png',           title: 'Meal log',          desc: 'Reusable meal templates and one-tap ingredient logging.' },
  { name: '10_radar.png',             title: 'Food radar',        desc: 'Per-food symptom profile — know at a glance which symptoms each food correlates with.' },
  { name: '8_impact.png',             title: 'Impact list',       desc: 'Foods that actually line up with your symptoms, ranked by correlation strength and FDR-gated for statistical honesty.' },
  { name: '9_heatmap.png',            title: 'Delay heatmap',     desc: 'Ingredient × time-window matrix: immediate, 4–12h, overnight.' },
];

// The full gallery for the bottom swipe strip.
const gallery = [
  { name: '1_startpage.png',                   label: 'Dashboard' },
  { name: '2_startpage_symptom_timeline.png',  label: 'Symptom timeline' },
  { name: '4_wellness_check.png',              label: 'Wellness check-in' },
  { name: '5_wellness_history.png',            label: 'Wellness history' },
  { name: '3_meal_log.png',                    label: 'Meal log' },
  { name: '6_insights.png',                    label: 'Insights overview' },
  { name: '7_calendar.png',                    label: 'Calendar' },
  { name: '8_impact.png',                      label: 'Impact list' },
  { name: '9_heatmap.png',                     label: 'Delay heatmap' },
  { name: '10_radar.png',                      label: 'Food radar' },
  { name: '11_scatter.png',                    label: 'Scatter plot' },
];
---
<BaseLayout title="GutCheck — Know what your gut is telling you" description="A local-first digestive health tracker. Log meals, feelings, and let data reveal your gut patterns.">

  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="hero-gradient absolute inset-0 -z-10"></div>
    <div class="absolute inset-0 -z-10 dot-grid opacity-40 [mask-image:radial-gradient(ellipse_at_center,black_30%,transparent_75%)]"></div>
    <div class="container-narrow pt-20 pb-24 md:pt-28 md:pb-32">
      <div class="grid gap-16 md:grid-cols-2 md:items-center">
        <div class="max-w-xl">
          <span class="eyebrow"><span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span> Open source · AGPLv3</span>
          <h1 class="mt-5 text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight leading-[1.05]">
            Know what your gut is telling you.
          </h1>
          <p class="mt-5 text-lg text-slate-600 dark:text-slate-300">
            GutCheck is a local-first digestive health tracker. Log meals, log how you feel, and let correlation math quietly surface what's been bothering you — all without sending a byte to the cloud.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href={`${BASE}download`} class="btn-primary">
              Get the app
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </a>
            <a href="https://github.com/FreaxMATE/GutCheck" class="btn-ghost">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.7.08-.7 1.17.08 1.79 1.2 1.79 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.75.41-1.27.74-1.56-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.19 1.18a11 11 0 0 1 5.8 0c2.22-1.49 3.19-1.18 3.19-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.25 5.68.42.36.8 1.08.8 2.18v3.24c0 .31.2.67.8.56A11.5 11.5 0 0 0 12 .5z"/></svg>
              Star on GitHub
            </a>
          </div>
          <dl class="mt-10 grid grid-cols-3 max-w-md gap-x-6 gap-y-2 text-sm">
            <div><dt class="text-slate-500 dark:text-slate-400">Platforms</dt><dd class="font-semibold">iOS · Android · Web · Linux · macOS</dd></div>
            <div><dt class="text-slate-500 dark:text-slate-400">Storage</dt><dd class="font-semibold">100% on-device</dd></div>
            <div><dt class="text-slate-500 dark:text-slate-400">Languages</dt><dd class="font-semibold">English · Deutsch</dd></div>
          </dl>
        </div>
        <div class="relative flex justify-center md:justify-end">
          <div class="relative flex items-end gap-4">
            <PhoneFrame name="10_radar.png" alt="Food radar chart" class="animate-float" />
            <PhoneFrame name="1_startpage.png" alt="Daily dashboard" class="hidden sm:block -mb-8" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section id="features" class="container-narrow py-20">
    <div class="max-w-2xl">
      <span class="eyebrow">What it does</span>
      <h2 class="mt-4 text-3xl sm:text-4xl font-bold tracking-tight">Your digestion, finally legible.</h2>
      <p class="mt-4 text-slate-600 dark:text-slate-300">Six focused tools that turn "I think dairy is bothering me" into evidence you can actually see.</p>
    </div>
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {features.map(f => <FeatureCard icon={f.icon} title={f.title} text={f.text} />)}
    </div>
  </section>

  <!-- SCREENSHOTS -->
  <section class="container-narrow py-20">
    <div class="max-w-2xl">
      <span class="eyebrow">A tour</span>
      <h2 class="mt-4 text-3xl sm:text-4xl font-bold tracking-tight">Six screens. Zero dashboards to configure.</h2>
      <p class="mt-4 text-slate-600 dark:text-slate-300">GutCheck shows up pre-wired with curated foods and sensible defaults so you can log your first meal in under a minute.</p>
    </div>
    <div class="mt-14 space-y-24">
      {shots.map((s, i) => (
        <div class={`grid gap-10 md:grid-cols-2 md:items-center ${i % 2 === 1 ? 'md:[&>*:first-child]:order-2' : ''}`}>
          <div>
            <span class="text-sm font-semibold text-brand-600 dark:text-brand-400">0{i+1}</span>
            <h3 class="mt-2 text-2xl font-bold tracking-tight">{s.title}</h3>
            <p class="mt-3 text-slate-600 dark:text-slate-300">{s.desc}</p>
          </div>
          <div class="flex justify-center"><PhoneFrame name={s.name} alt={s.title} /></div>
        </div>
      ))}
    </div>
  </section>

  <!-- GALLERY (swipeable) -->
  <section class="py-20 bg-gradient-to-b from-transparent via-brand-50/40 to-transparent dark:via-slate-900/40">
    <div class="container-narrow">
      <div class="max-w-2xl">
        <span class="eyebrow">Every screen</span>
        <h2 class="mt-4 text-3xl sm:text-4xl font-bold tracking-tight">Swipe through the whole app.</h2>
        <p class="mt-4 text-slate-600 dark:text-slate-300">Nothing hidden behind a paywall, no sign-up before the tour. Every screen, just a scroll away.</p>
      </div>
    </div>

    <!-- Horizontal snap scroller. Goes edge-to-edge so the cards peek in from
         the right, hinting there's more to see. -->
    <div class="mt-10 overflow-x-auto snap-x snap-mandatory scroll-px-6 [scrollbar-width:thin] pb-4">
      <div class="flex gap-6 px-6 md:px-[calc((100vw-72rem)/2+1.5rem)]">
        {gallery.map((g) => (
          <div class="snap-start shrink-0 w-[220px] md:w-[240px]">
            <PhoneFrame name={g.name} alt={g.label} />
            <p class="mt-3 text-center text-sm font-medium text-slate-700 dark:text-slate-300">{g.label}</p>
          </div>
        ))}
      </div>
    </div>
    <div class="container-narrow mt-2">
      <p class="text-xs text-slate-500 dark:text-slate-500">← swipe →</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-narrow pb-20">
    <div class="relative overflow-hidden rounded-3xl border border-slate-200 bg-gradient-to-br from-brand-600 to-brand-800 p-10 md:p-16 text-white dark:border-slate-800">
      <div class="absolute inset-0 opacity-20 [background:radial-gradient(rgba(255,255,255,0.35)_1px,transparent_1px)_0_0/18px_18px]"></div>
      <div class="relative max-w-2xl">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">Ready to find your triggers?</h2>
        <p class="mt-4 text-white/80">GutCheck is free and open-source. Build it yourself today, or wait for the store release — either way, your data stays yours.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`${BASE}download`} class="inline-flex items-center gap-2 rounded-xl bg-white text-brand-800 px-5 py-3 text-sm font-semibold hover:bg-white/90 transition">Install instructions</a>
          <a href="https://github.com/FreaxMATE/GutCheck" class="inline-flex items-center gap-2 rounded-xl border border-white/30 px-5 py-3 text-sm font-semibold hover:bg-white/10 transition">View source</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

---
// Ambient constellation background: dots drift slowly and draw faint lines
// to nearby neighbours. Brand-tinted so it matches the terracotta palette.
// Respects prefers-reduced-motion (renders a single static frame and stops).
//
// Props:
//   density    — target particle count at 1920×1080; auto-scales by area.
//   maxLink    — max distance (px) for drawing a connecting line.
//   className  — extra classes to place the canvas wrapper.
const {
  density = 75,
  maxLink = 140,
  class: className = '',
} = Astro.props;
---
<div class={`pointer-events-none absolute inset-0 overflow-hidden ${className}`} aria-hidden="true">
  <canvas data-starfield data-density={density} data-max-link={maxLink} class="h-full w-full"></canvas>
</div>

<script>
  type Dot = { x: number; y: number; vx: number; vy: number; r: number };

  function initStarField(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const density = Number(canvas.dataset.density ?? 75);
    const maxLink = Number(canvas.dataset.maxLink ?? 140);
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let dots: Dot[] = [];
    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    let w = 0;
    let h = 0;
    let rafId = 0;

    function brandColor(): { dot: string; line: (a: number) => string } {
      const isDark = document.documentElement.classList.contains('dark');
      // Terracotta tuned per theme so the constellation reads but doesn't dominate.
      return isDark
        ? {
            dot: 'rgba(241,177,121,0.55)',
            line: (a) => `rgba(241,177,121,${a.toFixed(3)})`,
          }
        : {
            dot: 'rgba(195,95,61,0.45)',
            line: (a) => `rgba(195,95,61,${a.toFixed(3)})`,
          };
    }

    function resize() {
      const rect = canvas.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      canvas.width = Math.floor(w * dpr);
      canvas.height = Math.floor(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      // Scale count by area so laptops and phones both look reasonable.
      const target = Math.max(18, Math.round((density * w * h) / (1920 * 1080)));
      if (dots.length !== target) {
        dots = Array.from({ length: target }, () => ({
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.18,
          vy: (Math.random() - 0.5) * 0.18,
          r: Math.random() * 1.2 + 0.6,
        }));
      }
    }

    function step() {
      if (!ctx) return;
      ctx.clearRect(0, 0, w, h);
      const c = brandColor();

      // Move and draw dots.
      ctx.fillStyle = c.dot;
      for (const d of dots) {
        d.x += d.vx;
        d.y += d.vy;
        if (d.x < 0 || d.x > w) d.vx *= -1;
        if (d.y < 0 || d.y > h) d.vy *= -1;
        ctx.beginPath();
        ctx.arc(d.x, d.y, d.r, 0, Math.PI * 2);
        ctx.fill();
      }

      // Connecting lines. O(n²) but n stays small (~50–120).
      ctx.lineWidth = 1;
      for (let i = 0; i < dots.length; i++) {
        const a = dots[i];
        for (let j = i + 1; j < dots.length; j++) {
          const b = dots[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const dist2 = dx * dx + dy * dy;
          if (dist2 > maxLink * maxLink) continue;
          const dist = Math.sqrt(dist2);
          const alpha = (1 - dist / maxLink) * 0.35;
          ctx.strokeStyle = c.line(alpha);
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }

      if (!reduceMotion) rafId = requestAnimationFrame(step);
    }

    resize();
    step();

    const ro = new ResizeObserver(() => {
      resize();
      if (reduceMotion) step();
    });
    ro.observe(canvas);

    // Re-draw static frame when the theme toggles (so colors follow).
    const themeObserver = new MutationObserver(() => {
      if (reduceMotion) step();
    });
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });

    // Pause when tab is hidden to save battery.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(rafId);
      } else if (!reduceMotion) {
        step();
      }
    });
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-starfield]').forEach(initStarField);
</script>

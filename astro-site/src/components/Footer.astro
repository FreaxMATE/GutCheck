---
const BASE = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-slate-200/70 dark:border-slate-800/70">
  <div class="container-narrow py-12 grid gap-10 md:grid-cols-4">
    <div class="md:col-span-2">
      <a href={BASE} class="flex items-center gap-2.5 font-semibold">
        <img src={`${BASE}brand/logo.png`} alt="GutCheck logo" class="h-8 w-8 rounded-lg" />
        <span>GutCheck</span>
      </a>
      <p class="mt-3 max-w-md text-sm text-slate-600 dark:text-slate-400">
        A local-first digestive health tracker. Log meals, log how you feel, and let data surface what your gut is trying to tell you.
      </p>
    </div>
    <div>
      <h4 class="text-sm font-semibold">Product</h4>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="link-muted" href={`${BASE}features`}>Features</a></li>
        <li><a class="link-muted" href={`${BASE}download`}>Download</a></li>
        <li><a class="link-muted" href={`${BASE}privacy`}>Privacy</a></li>
      </ul>
    </div>
    <div>
      <h4 class="text-sm font-semibold">Project</h4>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="link-muted" href="https://github.com/FreaxMATE/GutCheck">GitHub</a></li>
        <li><a class="link-muted" href="https://github.com/FreaxMATE/GutCheck/issues">Report an issue</a></li>
        <li><a class="link-muted" href="https://github.com/FreaxMATE/GutCheck/blob/main/LICENSE">License (AGPLv3)</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-slate-200/70 dark:border-slate-800/70">
    <div class="container-narrow py-6 text-xs text-slate-500 flex flex-wrap items-center justify-between gap-3">
      <span>© {year} GutCheck. Released under AGPLv3.</span>
      <span>Built with Flutter + Astro</span>
    </div>
  </div>
</footer>
